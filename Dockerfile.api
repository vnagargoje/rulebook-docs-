FROM node:22-alpine AS base
RUN corepack enable

FROM base AS build
WORKDIR /app
COPY package.json yarn.lock .yarnrc.yml ./
COPY packages ./packages
COPY apps ./apps

RUN yarn install --immutable
RUN yarn workspace @yugo/shared build
RUN yarn workspace @yugo/utils build
RUN yarn workspace @yugo/nestjs-database build
RUN yarn workspace @yugo/nestjs-framework build
RUN yarn workspace @yugo/api build

FROM base AS deps
WORKDIR /app
COPY package.json yarn.lock .yarnrc.yml ./
COPY packages ./packages
COPY apps ./apps
RUN yarn workspaces focus @yugo/api --production

FROM base AS production
WORKDIR /app
ENV NODE_ENV=production

COPY --from=deps /app/node_modules ./node_modules
COPY --from=build /app/packages ./packages
COPY --from=build /app/apps/api/dist ./apps/api/dist
COPY --from=build /app/apps/api/package.json ./apps/api/package.json
COPY migrations ./migrations

EXPOSE 4500
CMD ["node", "apps/api/dist/main.js"]

# Docker Image Tags (Managed by CI or manually)
API_TAG=latest
HENCHMEN_TAG=latest
BACKOFFICE_TAG=latest

# Traefik Dashboard Auth (User: admin)
# Generate hash using: htpasswd -nb admin your_password | sed -e s/\\$/\\$\\$/g
TRAEFIK_AUTH_USER=admin
TRAEFIK_AUTH_HASH=$$apr1$$YOUR_GENERATED_HASH...

# Watchtower Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

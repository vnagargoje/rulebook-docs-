FROM node:22-alpine AS base
RUN corepack enable

FROM base AS build
WORKDIR /app
RUN mkdir -p /app/dist
COPY package.json yarn.lock .yarnrc.yml turbo.json ./
COPY .yarn ./.yarn
COPY packages ./packages
COPY apps ./apps
COPY migrations ./migrations

RUN yarn install --immutable
RUN yarn turbo run build --filter=@yugo/cli...
RUN sh -c "test -f /app/apps/cli/dist/main.js -o -f /app/dist/apps/cli/main.js"

FROM base AS deps
WORKDIR /app
COPY package.json yarn.lock .yarnrc.yml ./
COPY .yarn ./.yarn
COPY packages ./packages
COPY apps ./apps
RUN yarn workspaces focus @yugo/cli --production

FROM base AS production
WORKDIR /app
ENV NODE_ENV=production

COPY --from=deps /app/node_modules ./node_modules
COPY --from=build /app/packages ./packages
COPY --from=build /app/apps/cli/dist ./apps/cli/dist
COPY --from=build /app/dist ./dist
COPY --from=build /app/apps/cli/package.json ./apps/cli/package.json
COPY --from=build /app/migrations ./migrations

CMD ["sh", "-c", "if [ -f apps/cli/dist/main.js ]; then node apps/cli/dist/main.js; elif [ -f dist/apps/cli/main.js ]; then node dist/apps/cli/main.js; else echo 'CLI entrypoint not found. Checked apps/cli/dist/main.js and dist/apps/cli/main.js' >&2; exit 1; fi"]

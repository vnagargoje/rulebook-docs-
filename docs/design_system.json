    "spacing_system": {
      "description": "Spacing rules aligned with design tokens",
      "padding": {
        "component": "Always a multiple of 2",
        "examples": ["4px", "8px", "12px", "16px", "20px", "24px"]
      },
      "margin": {
        "component": "Always a multiple of 2",
        "betweenElements": "Use lg (24px) for section spacing"
      },
      "gap": {
        "flex": "Always a multiple of 2",
        "grid": "Always a multiple of 2"
      }
    },

    "implementation": {
      "mobile": {
        "framework": "React Native + Expo",
        "stylingLibrary": "Tamagui",
        "cssFramework": "Uniwind (utility-first)",
        "colorSystem": "apps/app/src/components/ui/colors.js",
        "globalStyles": "apps/app/src/global.css",
        "typescriptConfig": "apps/app/tsconfig.json"
      },
      "admin": {
        "framework": "React + Vite",
        "stylingLibrary": "Tailwind CSS + shadcn/ui",
        "typescriptConfig": "apps/backoffice/tsconfig.json",
        "viteConfig": "apps/backoffice/vite.config.ts"
      },
      "sharedResources": {
        "colors": "Defined in multiple files for platform consistency",
        "typography": "Font family mappings in respective config files",
        "spacing": "Responsive multiples of 2px in each platform"
      }
    },

    "darkMode": {
      "description": "Dark mode implementation guidelines",
      "strategy": "System-based with user override option",
      "colorSchemes": ["light", "dark", "system"],
      "implementation": {
        "mobile": "Uniwind theme system with MMKV storage",
        "admin": "Tailwind CSS @media (prefers-color-scheme: dark)"
      },
      "statusBar": {
        "light": "Light content",
        "dark": "Dark content"

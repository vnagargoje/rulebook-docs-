{
    "name": "@yugo/nestjs-database",
    "version": "0.1.0",
    "type": "module",
    "private": true,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs",
            "default": "./dist/index.js"
        },
        "./entities": {
            "types": "./dist/entities.d.ts",
            "import": "./dist/entities.js",
            "require": "./dist/entities.cjs",
            "default": "./dist/entities.js"
        }
    },
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch"
    },
    "dependencies": {
        "@yugo/shared": "workspace:*",
        "mysql2": "^3.21.0",
        "typeorm": "^0.3.20",
        "typeorm-extension": "^3.9.0",
        "ulid": "^3.0.2"
    },
    "devDependencies": {
        "@yugo/tsconfig": "workspace:*",
        "tsup": "^8.0.0",
        "typeorm": "^0.3.20",
        "typescript": "^5.4.5"
    }
}

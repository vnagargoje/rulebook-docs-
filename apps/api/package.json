{
    "name": "@yugo/api",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "concurrently \"nest start --watch\" \"tsc-alias -w -p tsconfig.json\"",
        "build": "nest build && tsc-alias -p tsconfig.json",
        "lint": "eslint \"{src,test}/**/*.ts\"",
        "clean": "rimraf dist"
    },
    "dependencies": {
        "@liaoliaots/nestjs-redis": "^10.0.0",
        "@nestjs/common": "^11.0.1",
        "@nestjs/config": "^4.0.4",
        "@nestjs/core": "^11.0.1",
        "@nestjs/jwt": "^11.0.2",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-express": "^11.0.1",
        "@nestjs/swagger": "^11.0.0",
        "@nestjs/typeorm": "^11.0.1",
        "@scalar/nestjs-api-reference": "^1.1.7",
        "@sinclair/typebox": "^0.34.49",
        "@yugo/nestjs-database": "workspace:*",
        "@yugo/nestjs-framework": "workspace:*",
        "@yugo/shared": "workspace:*",
        "@yugo/utils": "workspace:*",
        "change-case": "^5.4.4",
        "change-case-all": "^2.1.0",
        "helmet": "^8.1.0",
        "ioredis": "^5.10.1",
        "mysql2": "^3.21.0",
        "nestjs-paginate": "^12.10.0",
        "nestjs-pino": "^4.6.1",
        "passport": "^0.7.0",
        "passport-custom": "^1.1.1",
        "passport-jwt": "^4.0.1",
        "pino-http": "^8.0.0",
        "pino-pretty": "^10.0.0",
        "qs": "^6.15.1",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "typeorm": "^0.3.28"
    },
    "devDependencies": {
        "@nestjs/cli": "^11.0.0",
        "@nestjs/schematics": "^11.0.0",
        "@nestjs/testing": "^11.0.1",
        "@types/express": "^5.0.0",
        "@types/helmet": "^4.0.0",
        "@types/node": "^22.10.7",
        "@types/passport": "^0",
        "@types/passport-jwt": "^4",
        "@types/qs": "^6.15.0",
        "@yugo/eslint": "workspace:*",
        "@yugo/tsconfig": "workspace:*",
        "concurrently": "^9.2.1",
        "rimraf": "^5.0.5",
        "source-map-support": "^0.5.21",
        "tsc-alias": "^1.8.16",
        "typescript": "^5.7.3"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    }
}

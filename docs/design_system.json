    "typography": {
      "description": "Typography scale and font families",
      "fonts": {
        "heading": {
          "family": "Poppins",
          "usage": "Headlines, titles, and large text elements",
          "weights": [400, 500, 600, 700]
        },
        "body": {
          "family": "Roboto",
          "usage": "Body text, paragraphs, and general content",
          "weights": [400, 500, 700]
        },
        "mono": {
          "family": "Roboto Mono",
          "usage": "Code blocks and technical content",
          "weights": [400, 500, 700]
        }
      },
      "scales": {
        "h1": {
          "size": 48,
          "lineHeight": 56,
          "fontFamily": "Poppins",
          "fontWeight": 700,
          "letterSpacing": -0.5,
          "description": "Main page headings"
        },
        "h2": {
          "size": 40,
          "lineHeight": 48,
          "fontFamily": "Poppins",
          "fontWeight": 700,
          "letterSpacing": -0.3,
          "description": "Section headings"
        },
        "h3": {
          "size": 32,
          "lineHeight": 40,
          "fontFamily": "Poppins",
          "fontWeight": 600,
          "letterSpacing": 0,
          "description": "Subsection headings"
        },
        "h4": {
          "size": 26,
          "lineHeight": 32,
          "fontFamily": "Poppins",
          "fontWeight": 600,
          "letterSpacing": 0,
          "description": "Secondary headings"
        },
        "h5": {
          "size": 24,
          "lineHeight": 32,
          "fontFamily": "Poppins",
          "fontWeight": 600,
          "letterSpacing": 0,
          "description": "Tertiary headings"

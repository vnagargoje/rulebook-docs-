    },
    "peerDependencies": {
        "@nestjs/common": "*",
        "@nestjs/config": "*",
        "@nestjs/core": "*",
        "@nestjs/cqrs": "^11.0.3",
        "@nestjs/typeorm": "*",
        "@yugo/nestjs-database": "workspace:*",
        "@yugo/nestjs-fcm": "workspace:*",
        "@yugo/shared": "workspace:*",
        "@yugo/utils": "workspace:*",
        "nestjs-paginate": "^12.10.0",
        "reflect-metadata": "*",
        "typeorm": "*"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1030.0",
        "@types/qrcode": "^1.5.6",
        "@yugo/nestjs-database": "workspace:*",
        "@yugo/nestjs-fcm": "workspace:*",
        "@yugo/shared": "workspace:*",
        "@yugo/utils": "workspace:*",
        "builder-pattern": "^2.2.0",
        "date-fns": "^4.1.0",
        "qrcode": "^1.5.4",
        "razorpay": "^2.9.6",
        "xior": "^0.8.3"
    }

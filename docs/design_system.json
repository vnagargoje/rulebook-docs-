    "spacing": {
      "description": "Global spacing scale - all values are multiples of 4px (base unit)",
      "base": 4,
      "unit": "px",
      "scale": {
        "0": 0,
        "1": 4,
        "2": 8,
        "3": 12,
        "4": 16,
        "5": 20,
        "6": 24,
        "7": 28,
        "8": 32,
        "9": 36,
        "10": 40,
        "11": 44,
        "12": 48,
        "14": 56,
        "16": 64,
        "20": 80,
        "24": 96,
        "28": 112,
        "32": 128,
        "36": 144,
        "40": 160,
        "44": 176,
        "48": 192,
        "52": 208,
        "56": 224,
        "60": 240,
        "64": 256,
        "72": 288,
        "80": 320,
        "96": 384
      },
      "aliases": {
        "xs": 4,
        "sm": 8,
        "md": 16,
        "lg": 24,
        "xl": 32,
        "2xl": 48,
        "3xl": 64
      },
      "usage": {
        "padding": "Applies to component padding",
        "margin": "Applies to component margins",
        "gap": "Applies to flex and grid gaps",
        "height": "Component heights",
        "width": "Component widths"
      }
    },

    "borderRadius": {
      "description": "Border radius scale for consistent corner rounding",
      "scale": {
        "none": 0,
        "sm": 4,
        "base": 8,
        "md": 12,
        "lg": 16,
        "xl": 20,
        "2xl": 24,
        "3xl": 32,
        "full": 9999
      },
      "usage": {
        "sm": "Small buttons, small components",
        "base": "Standard cards, inputs, buttons",
        "md": "Larger cards, modals",
        "lg": "Large interactive elements",
        "full": "Circular elements, avatars"
      }
    },

    "shadows": {
      "description": "Shadow elevation system for depth",
      "scale": {
        "none": "0 0 0 0 rgba(0, 0, 0, 0)",
        "sm": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
        "base": "0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06)",
        "md": "0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06)",
        "lg": "0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05)",
        "xl": "0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04)",
        "2xl": "0 25px 50px -12px rgba(0, 0, 0, 0.25)"
      },
      "usage": {
        "sm": "Subtle elevation for hover states",
        "md": "Cards, containers",
        "lg": "Modals, dropdowns",
        "xl": "Floating action buttons",
        "2xl": "Popovers, menus"
      }
    },

    "animations": {
      "description": "Animation and transition presets for consistent motion",
      "durations": {
        "fast": 150,
        "normal": 300,
        "slow": 500
      },
      "easing": {
        "ease_in": "cubic-bezier(0.4, 0, 1, 1)",
        "ease_out": "cubic-bezier(0, 0, 0.2, 1)",
        "ease_in_out": "cubic-bezier(0.4, 0, 0.2, 1)",
        "linear": "linear"
      },
      "presets": {
        "fade": {
          "duration": 300,
          "easing": "ease_in_out",
          "description": "Opacity transition"
        },
        "slide_in": {
          "duration": 300,
          "easing": "ease_out",
          "description": "Slide in from edge"
        },
        "scale": {
          "duration": 300,
          "easing": "ease_out",
          "description": "Scale transformation"
        }
      }
    },

    "uiLibraries": {
      "mobile": {
        "name": "Tamagui",
        "url": "https://tamagui.dev/",
        "description": "UI component library for mobile app (React Native)",
        "usage": "Primary UI framework for the Yugo mobile application",
        "components": [
          "Button",
          "Card",
          "Input",
          "Text",
          "View",
          "ScrollView",
          "Modal",
          "Checkbox",
          "Select",
          "Progress"
        ]
      },
      "admin": {
        "name": "Tailwind CSS + shadcn/ui",
        "url": "https://tailwindcss.com/",
        "description": "Tailwind CSS utility-first framework paired with shadcn/ui component library",
        "usage": "Primary UI framework for the admin dashboard",
        "components": [
          "Button",
          "Card",
          "Input",
          "Label",
          "Select",
          "Checkbox",
          "RadioGroup",
          "Dialog",
          "Sheet",
          "Tabs",
          "Alert",
          "Badge",
          "Tooltip"
        ],
        "tailwindConfig": {
          "extend": {
            "colors": {
              "primary": "#FF7B1A",
              "primary-foreground": "#FFFFFF",
              "secondary": "#00ADB1",
              "accent": "#FFA200",
              "destructive": "#EF4444"
            }
          }
        }
      }
    },

    "iconLibrary": {
      "name": "Phosphor Icons",
      "url": "https://phosphoricons.com/",
      "description": "Flexible icon library with 6000+ icons",
      "usage": "All icons across mobile and admin applications",
      "features": [
        "6 weight options (Thin, Light, Regular, Bold, Fill)",
        "16 sizes from 16px to 128px",
        "Multiple formats (SVG, PNG, PDF)",
        "Customizable colors and weights"
      ],
      "weights": ["thin", "light", "regular", "bold", "fill"],
      "sizes": [16, 20, 24, 28, 32, 40, 48, 56, 64, 128],
      "commonIcons": {
        "navigation": ["House", "Heart", "MagnifyingGlass", "GearSix", "List"],
        "actions": ["Plus", "Trash", "Pencil", "Download", "Upload"],
        "status": ["CheckCircle", "XCircle", "Warning", "Info"],
        "social": ["GoogleLogo", "GithubLogo", "LinkedinLogo", "TwitterLogo"]
      }
    },


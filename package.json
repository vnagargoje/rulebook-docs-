{
    "name": "yugo",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/nestjs/*",
        "packages/shared/*"
    ],
    "nohoist": [
        "apps/app/*",
        "react-native",
        "react-native/**",
        "expo",
        "react-native-css-interop"
    ],
    "scripts": {
        "dev": "turbo run dev",
        "build": "turbo run build",
        "lint": "turbo run lint",
        "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
        "clean": "turbo run clean && rimraf node_modules",
        "test": "turbo run test",
        "cli": "yarn workspace @yugo/cli start --"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.0.0",
        "@eslint/js": "^9.0.0",
        "@swc/core": "^1.15.24",
        "eslint": "^9.0.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.1.3",
        "prettier": "^3.2.5",
        "reflect-metadata": "^0.2.2",
        "rimraf": "^5.0.5",
        "turbo": "^2.0.0",
        "typescript": "^5.4.5"
    },
    "packageManager": "yarn@4.6.0"
}
